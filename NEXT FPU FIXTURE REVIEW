 143: // PS2 float semantics (EE FPU and VU0 macro mode). The PS2 format has no Inf, NaN or denormals:
 144: //   - exponent 255 is an ordinary exponent, so 0x7F800000 is 2^128 and the largest value is 0x7FFFFFFF;
 145: //   - exponent 0 is zero whatever the mantissa holds;
 146: //   - a result of 2^129 or more saturates to +-0x7FFFFFFF, one below 2^-126 becomes +-0;
 147: //   - x/0 gives +-0x7FFFFFFF.
 148: // A host float cannot hold the exponent-255 values, so anything that touches them is computed in double.
 149: // That path is rare and kept out of line; the inline part is the host operation and a range check.
 150: // One case is left to the host: ADD.S/SUB.S/MUL.S and the vector operations do not look for an operand with
 151: // exponent 0 and a non-zero mantissa, so it takes part with its tiny host value instead of as zero.
 152: // Checked against the hardware results in ps2autotests (tests/cpu/ee_fpu).
 153: #if defined(_MSC_VER)
 154: #define PS2_FLOAT_NOINLINE __declspec(noinline)
 155: #else
 156: #define PS2_FLOAT_NOINLINE __attribute__((noinline))
 157: #endif
 158: 
 159: constexpr uint32_t PS2_FLOAT_MAX_BITS = 0x7FFFFFFFu;
 160: constexpr uint32_t PS2_FLOAT_EXP_MASK = 0x7F800000u;
 161: constexpr uint32_t PS2_FLOAT_SIGN_MASK = 0x80000000u;
 162: 
 163: // True when a host float operation cannot be trusted with x: exponent 255, or exponent 0 with a mantissa.
 164: inline bool ps2_fspecial(float x)
 165: {
 166:     const uint32_t t = std::bit_cast<uint32_t>(x) & 0x7FFFFFFFu;
 167:     return t != 0u && (t - 0x00800000u) >= 0x7F000000u;
 168: }
 169: 
 170: inline double ps2_to_double(float x)
 171: {
 172:     uint32_t b = std::bit_cast<uint32_t>(x);
 173:     const uint32_t exponent = b & PS2_FLOAT_EXP_MASK;
 174:     if (exponent == 0u)
 175:         return static_cast<double>(std::bit_cast<float>(b & PS2_FLOAT_SIGN_MASK));
 176:     if (exponent == PS2_FLOAT_EXP_MASK)
 177:         return static_cast<double>(std::bit_cast<float>(b - 0x00800000u)) * 2.0;
 178:     return static_cast<double>(x);
 179: }
 180: 
 181: inline float ps2_from_double(double d)
 182: {
 183:     const double magnitude = std::fabs(d);
 184:     const uint32_t sign = std::signbit(d) ? PS2_FLOAT_SIGN_MASK : 0u;
 185:     if (magnitude >= 0x1p129)
 186:         return std::bit_cast<float>(sign | PS2_FLOAT_MAX_BITS);
 187:     if (magnitude < 0x1p-126)
 188:         return std::bit_cast<float>(sign);
 189:     if (magnitude >= 0x1p128)
 190:     {
 191:         // Convert one exponent lower, then put the exponent back as 255.
 192:         const uint32_t b = std::bit_cast<uint32_t>(static_cast<float>(d * 0.5));
 193:         if ((b & PS2_FLOAT_EXP_MASK) == PS2_FLOAT_EXP_MASK)
 194:             return std::bit_cast<float>(sign | PS2_FLOAT_MAX_BITS);
 195:         return std::bit_cast<float>(b + 0x00800000u);
 196:     }
 197:     // A value that rounds up to 2^128 comes out as the host's Inf pattern, which is 2^128 on the PS2.
 198:     return static_cast<float>(d);
 199: }
 200: 
 201: PS2_FLOAT_NOINLINE inline float ps2_fadd_slow(float a, float b)
 202: {
 203:     // Zero operands and results end up here too; the host result is right for them.
 204:     const float r = a + b;
 205:     if (!(ps2_fspecial(a) | ps2_fspecial(b) | ps2_fspecial(r)))
 206:         return r;
 207:     return ps2_from_double(ps2_to_double(a) + ps2_to_double(b));
 208: }
 209: 
 210: PS2_FLOAT_NOINLINE inline float ps2_fsub_slow(float a, float b)
 211: {
 212:     // Zero operands and results end up here too; the host result is right for them.
 213:     const float r = a - b;
 214:     if (!(ps2_fspecial(a) | ps2_fspecial(b) | ps2_fspecial(r)))
 215:         return r;
 216:     return ps2_from_double(ps2_to_double(a) - ps2_to_double(b));
 217: }
 218: 
 219: PS2_FLOAT_NOINLINE inline float ps2_fmul_slow(float a, float b)
 220: {
 221:     // Zero operands and results end up here too; the host result is right for them.
 222:     const float r = a * b;
 223:     if (!(ps2_fspecial(a) | ps2_fspecial(b) | ps2_fspecial(r)))
 224:         return r;
 225:     return ps2_from_double(ps2_to_double(a) * ps2_to_double(b));
 226: }
 227: 
 228: // A zero divisor gives +-max with the sign of fs xor ft.
 229: PS2_FLOAT_NOINLINE inline float ps2_fdiv_slow(float a, float b)
 230: {
 231:     const uint32_t ua = std::bit_cast<uint32_t>(a);
 232:     const uint32_t ub = std::bit_cast<uint32_t>(b);
 233:     if ((ub & PS2_FLOAT_EXP_MASK) == 0u)
 234:         return std::bit_cast<float>(((ua ^ ub) & PS2_FLOAT_SIGN_MASK) | PS2_FLOAT_MAX_BITS);
 235:     const float r = a / b;
 236:     if (!(ps2_fspecial(a) | ps2_fspecial(b) | ps2_fspecial(r)))
 237:         return r;
 238:     return ps2_from_double(ps2_to_double(a) / ps2_to_double(b));
 239: }
 240: 
 241: // sqrt(|ft|); the result is never negative, sqrt(-0) is +0.
 242: PS2_FLOAT_NOINLINE inline float ps2_fsqrt_slow(float a)
 243: {
 244:     if ((std::bit_cast<uint32_t>(a) & PS2_FLOAT_EXP_MASK) == 0u)
 245:         return 0.0f;
 246:     return ps2_from_double(std::sqrt(std::fabs(ps2_to_double(a))));
 247: }
 248: 
 249: // fs / sqrt(|ft|). The sign of ft is ignored everywhere, so a zero ft gives +-max with the sign of fs alone.
 250: PS2_FLOAT_NOINLINE inline float ps2_frsqrt_slow(float a, float b)
 251: {
 252:     if ((std::bit_cast<uint32_t>(b) & PS2_FLOAT_EXP_MASK) == 0u)
 253:         return std::bit_cast<float>((std::bit_cast<uint32_t>(a) & PS2_FLOAT_SIGN_MASK) | PS2_FLOAT_MAX_BITS);
 254:     // The root is rounded to a float before the division, as on the hardware.
 255:     const float root = ps2_from_double(std::sqrt(std::fabs(ps2_to_double(b))));
 256:     return ps2_from_double(ps2_to_double(a) / static_cast<double>(root));
 257: }
 258: 
 259: // True when a, b and the host result r are all normal numbers, so r is also the PS2 result.
 260: inline bool ps2_fall_normal(float a, float b, float r)
 261: {
 262:     // Doubling drops the sign; adding one exponent step wraps exponent 255 round to 0 next to exponent 0.
 263:     const uint32_t sa = std::bit_cast<uint32_t>(a) * 2u + 0x01000000u;
 264:     const uint32_t sb = std::bit_cast<uint32_t>(b) * 2u + 0x01000000u;
 265:     const uint32_t sr = std::bit_cast<uint32_t>(r) * 2u + 0x01000000u;
 266:     uint32_t lowest = sa < sb ? sa : sb;
 267:     lowest = lowest < sr ? lowest : sr;
 268:     return lowest >= 0x02000000u;
 269: }
 270: 
 271: // The same test on the result alone. An exponent-255 operand always leaves exponent 255 in the host result
 272: // of an addition, subtraction or multiplication (Inf or NaN), so this finds those operands as well.
 273: inline bool ps2_fnormal(float r)
 274: {
 275:     return (std::bit_cast<uint32_t>(r) * 2u + 0x01000000u) >= 0x02000000u;
 276: }
 277: 
 278: inline float ps2_fadd(float a, float b)
 279: {
 280:     const float r = a + b;
 281:     return ps2_fnormal(r) ? r : ps2_fadd_slow(a, b);
 282: }
 283: 
 284: inline float ps2_fsub(float a, float b)
 285: {
 286:     const float r = a - b;
 287:     return ps2_fnormal(r) ? r : ps2_fsub_slow(a, b);
 288: }
 289: 
 290: inline float ps2_fmul(float a, float b)
 291: {
 292:     const float r = a * b;
 293:     return ps2_fnormal(r) ? r : ps2_fmul_slow(a, b);
 294: }
 295: 
 296: inline float ps2_fdiv(float a, float b)
 297: {
 298:     const float r = a / b;
 299:     return ps2_fall_normal(a, b, r) ? r : ps2_fdiv_slow(a, b);
 300: }
 301: 
 302: inline float ps2_fsqrt(float a)
 303: {
 304:     const float r = std::sqrt(a);
 305:     return ps2_fall_normal(a, a, r) ? r : ps2_fsqrt_slow(a);
 306: }
 307: 
 308: inline float ps2_frsqrt(float a, float b)
 309: {
 310:     const float r = a / std::sqrt(b);
 311:     return ps2_fall_normal(a, b, r) ? r : ps2_frsqrt_slow(a, b);
 312: }
