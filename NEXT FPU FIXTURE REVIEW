 691:                                      _mm_xor_si128(a, diff));
 692:     // Extract input sign.
 693:     overflow = _mm_srai_epi32(overflow, 31);
 694:     __m128i input_sign = _mm_srai_epi32(a, 31);
 695:     // Select saturation value based on overflow sign.
 696:     #if defined(__SSE4_1__)
