 802:     _mm_storeu_si128((__m128i *)a_arr, a);
 803:     _mm_storeu_si128((__m128i *)count_arr, count);
 804:     for (int i = 0; i < 4; i++)
 805:     {
 806:         result[i] = (uint32_t)a_arr[i] >> (count_arr[i] & 0x1F);
 807:     }
 808:     return _mm_loadu_si128((__m128i *)result);
 809: }
