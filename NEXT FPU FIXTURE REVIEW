 885: template <typename Ctx>
 886: inline void ps2_pmthl_lw(Ctx *ctx, __m128i value)
 887: {
 888:     alignas(16) uint32_t words[4];
 889:     _mm_store_si128(reinterpret_cast<__m128i *>(words), value);
 890:     ctx->lo = (ctx->lo & 0xFFFFFFFF00000000ull) | words[0];
 891:     ctx->hi = (ctx->hi & 0xFFFFFFFF00000000ull) | words[1];
 892:     ctx->lo1 = (ctx->lo1 & 0xFFFFFFFF00000000ull) | words[2];
 893:     ctx->hi1 = (ctx->hi1 & 0xFFFFFFFF00000000ull) | words[3];
 894: }
