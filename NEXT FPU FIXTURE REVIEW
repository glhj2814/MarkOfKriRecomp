 734:     __m128i underflow = _mm_cmpgt_epi32(_mm_xor_si128(b, _mm_set1_epi32(INT32_MIN)),
 735:                                         _mm_xor_si128(a, _mm_set1_epi32(INT32_MIN)));
 736:     return _mm_andnot_si128(underflow, diff); // underflow lanes become 0
 737: }
