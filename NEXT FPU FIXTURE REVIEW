 658: // Packed Add with Signed Saturation Word (PADDSW)
 659: inline __m128i ps2_paddsw(__m128i a, __m128i b)
 660: {
 661: 
 662:     __m128i sum = _mm_add_epi32(a, b);
 663:     // Check for over/underflow. Clamp to either INT32_MIN/INT32_MAX.
 664:     __m128i overflow = _mm_and_si128(_mm_xor_si128(a, sum),
 665:                                      _mm_xor_si128(b, sum));
 666:     // Extract input sign.
 667:     overflow = _mm_srai_epi32(overflow, 31);
 668:     __m128i input_sign = _mm_srai_epi32(a, 31);
 669:     // Select saturation value based on overflow sign.
 670:     #if defined(__SSE4_1__)
 671:     __m128i sat = _mm_blendv_epi8(
 672:         _mm_set1_epi32(INT32_MAX),
 673:         _mm_set1_epi32(INT32_MIN),
 674:         input_sign);
 675:     return _mm_blendv_epi8(sum, sat, overflow);
 676:     #else
 677:     __m128i sat = _mm_or_si128(_mm_and_si128(input_sign, _mm_set1_epi32(INT32_MIN)),
 678:                                _mm_andnot_si128(input_sign, _mm_set1_epi32(INT32_MAX)));
 679:     return _mm_or_si128(_mm_and_si128(overflow, sat),
 680:                         _mm_andnot_si128(overflow, sum));
 681:     #endif
 682: }
 683: #define PS2_PADDSW(a, b) ps2_paddsw((__m128i)(a), (__m128i)(b))
