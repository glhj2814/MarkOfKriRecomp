 394: static inline uint16_t Ps2FastRead16(const uint8_t *rdram, uint32_t addr)
 395: {
 396:     const uint32_t offset = addr & PS2_RAM_MASK;
 397:     if (!Ps2FastRangeIsContiguous(offset, sizeof(uint16_t)))
 398:     {
 399:         uint8_t wrapped[sizeof(uint16_t)];
 400:         for (uint32_t i = 0; i < sizeof(uint16_t); ++i)
 401:         {
 402:             wrapped[i] = rdram[(offset + i) & PS2_RAM_MASK];
 403:         }
 404:         uint16_t value;
 405:         std::memcpy(&value, wrapped, sizeof(value));
 406:         return value;
 407:     }
 408: 
 409:     uint16_t value;
 410:     std::memcpy(&value, rdram + offset, sizeof(value));
 411:     return value;
 412: }
