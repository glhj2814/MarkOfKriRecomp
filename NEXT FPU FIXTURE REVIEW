 829: // PMFHL/PMTHL see LO and HI as 128-bit registers: pipeline 0 in bits 0-63 (lo/hi) and pipeline 1 in
 830: // bits 64-127 (lo1/hi1). PMFHL.LW after MULTU is how EE code reads a full 64-bit product.
 831: inline int16_t ps2_saturate_s16(uint32_t word)
 832: {
 833:     const int32_t value = static_cast<int32_t>(word);
 834:     return static_cast<int16_t>(value > 0x7FFF ? 0x7FFF : (value < -0x8000 ? -0x8000 : value));
 835: }
 836: 
 837: inline int64_t ps2_pmfhl_slw_lane(uint64_t hi, uint64_t lo)
 838: {
 839:     const int64_t value = static_cast<int64_t>((static_cast<uint64_t>(static_cast<uint32_t>(hi)) << 32) | static_cast<uint32_t>(lo));
 840:     if (value >= 0x7FFFFFFFll)
 841:         return 0x7FFFFFFFll;
 842:     if (value <= -0x80000000ll)
 843:         return -0x80000000ll;
 844:     return static_cast<int32_t>(lo);
 845: }
