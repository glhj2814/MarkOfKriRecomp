using GeneratedFpuFunction =
    void (*)(uint8_t*, R5900Context*, PS2Runtime*);

void generated_fpu_adda(uint8_t*, R5900Context*, PS2Runtime*);
void generated_fpu_suba(uint8_t*, R5900Context*, PS2Runtime*);
void generated_fpu_mula(uint8_t*, R5900Context*, PS2Runtime*);
void generated_fpu_madd(uint8_t*, R5900Context*, PS2Runtime*);
void generated_fpu_msub(uint8_t*, R5900Context*, PS2Runtime*);
void generated_fpu_madda(uint8_t*, R5900Context*, PS2Runtime*);
void generated_fpu_msuba(uint8_t*, R5900Context*, PS2Runtime*);
void generated_fpu_sequence_mula_madda(uint8_t*, R5900Context*, PS2Runtime*);

static R5900Context makeGeneratedFpuContext()
{
    R5900Context ctx{};
    ctx.f[1] = 2.0f;
    ctx.f[2] = 3.0f;
    ctx.f[3] = 0.0f;
    ctx.f_acc = 5.0f;
    return ctx;
}

void register_generated_fpu_execution_tests()
{
    MiniTest::Case("GeneratedFPUExecution", [](TestCase& tc)
    {
        tc.Run("generated ADDA.S updates live accumulator", [](TestCase& t) {
            auto ctx = makeGeneratedFpuContext();
            ctx.f_acc = 9.0f;
            generated_fpu_adda(nullptr, &ctx, nullptr);
            t.Equals(ctx.f_acc, 5.0f, "ADDA.S overwrites prior accumulator");
            t.Equals(ctx.pc, 0x100004u, "ADDA.S final PC");
        });

        tc.Run("generated SUBA.S updates live accumulator", [](TestCase& t) {
            auto ctx = makeGeneratedFpuContext();
            generated_fpu_suba(nullptr, &ctx, nullptr);
            t.Equals(ctx.f_acc, -1.0f, "SUBA.S accumulator");
            t.Equals(ctx.pc, 0x100014u, "SUBA.S final PC");
