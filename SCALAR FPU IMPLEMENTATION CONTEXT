        tc.Run("generated MULA.S updates live accumulator", [](TestCase& t) {
            auto ctx = makeGeneratedFpuContext();
            generated_fpu_mula(nullptr, &ctx, nullptr);
            t.Equals(ctx.f_acc, 6.0f, "MULA.S accumulator");
            t.Equals(ctx.pc, 0x100024u, "MULA.S final PC");
        });

        tc.Run("generated MADD.S writes destination FPR", [](TestCase& t) {
