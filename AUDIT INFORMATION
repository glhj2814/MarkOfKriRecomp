  181: inline float ps2_from_double(double d)
  182: {
  183:     const double magnitude = std::fabs(d);
  184:     const uint32_t sign = std::signbit(d) ? PS2_FLOAT_SIGN_MASK : 0u;
  185:     if (magnitude >= 0x1p129)
  186:         return std::bit_cast<float>(sign | PS2_FLOAT_MAX_BITS);
  187:     if (magnitude < 0x1p-126)
  188:         return std::bit_cast<float>(sign);
  189:     if (magnitude >= 0x1p128)
  190:     {
  191:         // Convert one exponent lower, then put the exponent back as 255.
  192:         const uint32_t b = std::bit_cast<uint32_t>(static_cast<float>(d * 0.5));
  193:         if ((b & PS2_FLOAT_EXP_MASK) == PS2_FLOAT_EXP_MASK)
  194:             return std::bit_cast<float>(sign | PS2_FLOAT_MAX_BITS);
  195:         return std::bit_cast<float>(b + 0x00800000u);
  196:     }
  197:     // A value that rounds up to 2^128 comes out as the host's Inf pattern, which is 2^128 on the PS2.
  198:     return static_cast<float>(d);
  199: }
