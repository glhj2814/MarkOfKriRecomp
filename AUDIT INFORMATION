  259: // True when a, b and the host result r are all normal numbers, so r is also the PS2 result.
  260: inline bool ps2_fall_normal(float a, float b, float r)
  261: {
  262:     // Doubling drops the sign; adding one exponent step wraps exponent 255 round to 0 next to exponent 0.
  263:     const uint32_t sa = std::bit_cast<uint32_t>(a) * 2u + 0x01000000u;
  264:     const uint32_t sb = std::bit_cast<uint32_t>(b) * 2u + 0x01000000u;
  265:     const uint32_t sr = std::bit_cast<uint32_t>(r) * 2u + 0x01000000u;
  266:     uint32_t lowest = sa < sb ? sa : sb;
  267:     lowest = lowest < sr ? lowest : sr;
  268:     return lowest >= 0x02000000u;
  269: }
