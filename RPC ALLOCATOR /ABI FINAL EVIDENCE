  357:     uint8_t allocCount = (dataCount == 0) ? 1 : dataCount;
  358:     size_t bytes = static_cast<size_t>(1 + allocCount) * sizeof(uint32_t);
  359:     uint32_t addr = allocBootModeAddr(rdram, bytes);
  360:     if (!addr)
  361:         return 0;
  362: 
  363:     uint32_t header = (static_cast<uint32_t>(lenField) << 24) |
  364:                       (static_cast<uint32_t>(id) << 16) |
  365:                       (static_cast<uint32_t>(value) & 0xFFFFu);
  366: 
  367:     uint32_t *dst = reinterpret_cast<uint32_t *>(getMemPtr(rdram, addr));
  368:     if (!dst)
  369:         return 0;
  370: 
  371:     dst[0] = header;
  372:     for (uint8_t i = 0; i < allocCount; ++i)
  373:     {
  374:         dst[1 + i] = (data && i < dataCount) ? data[i] : 0;
  375:     }
  376: 
  377:     return addr;
  378: }
