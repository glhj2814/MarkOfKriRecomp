  293:     RpcResult IopRpcBridge::handleRpc(const RpcRequest &request, IopGuestExecutor &executor)
  294:     {
  295:         RpcResult result{};
  296:         const auto serverIt = m_servers.find(request.sid);
  297:         if (serverIt == m_servers.end() || serverIt->second.function == 0u)
  298:             return result;
  299: 
  300:         RpcServer &server = serverIt->second;
  301:         if (request.send.size != 0u && server.buffer != 0u)
  302:         {
  303:             const uint32_t copySize = std::min<uint32_t>(request.send.size, IopMemory::RamSize - std::min(server.buffer, IopMemory::RamSize));
  304:             if (copySize != 0u)
  305:             {
  306:                 std::vector<uint8_t> payload(copySize);
  307:                 if (m_host.readGuest(request.send.address, payload.data(), payload.size()))
  308:                     (void)m_memory.writeRam(server.buffer, payload.data(), payload.size());
  309:             }
  310:         }
  311: 
  312:         uint32_t returnPointer = executor.executeGuestFunction(server.function,
  313:                                                                request.function,
  314:                                                                server.buffer,
  315:                                                                request.send.size,
  316:                                                                0u,
  317:                                                                server.gp);
  318:         if (returnPointer == 0u)
  319:             returnPointer = server.buffer;
  320:         if (request.receive.address != 0u && request.receive.size != 0u && returnPointer != 0u)
  321:         {
  322:             const uint32_t physical = IopMemory::physicalAddress(returnPointer);
  323:             if (physical < IopMemory::RamSize)
  324:             {
  325:                 const uint32_t copySize = std::min<uint32_t>(request.receive.size, IopMemory::RamSize - physical);
  326:                 (void)m_host.writeGuest(request.receive.address, m_memory.ram().data() + physical, copySize);
  327:                 if (copySize < request.receive.size)
  328:                     (void)m_host.zeroGuest(request.receive.address + copySize, request.receive.size - copySize);
  329:             }
  330:         }
  331: 
  332:         result.handled = true;
  333:         result.resultAddress = request.receive.address;
  334:         result.serverDispatchPolicy = ServerDispatchPolicy::Suppress;
  335:         result.signalNowaitCompletion = true;
  336:         result.signalCompletion = true;
  337:         return result;
  338:     }
