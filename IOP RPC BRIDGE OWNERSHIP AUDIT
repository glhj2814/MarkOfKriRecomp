  122: 
  123:         if (parsed.device != Ps2PathDevice::Rom0)
  124:         {
  125:             ModuleLoadResult physical = m_impl->emulator.loadModule(path, arguments, argumentSize);
  126:             if (physical.moduleId > 0)
