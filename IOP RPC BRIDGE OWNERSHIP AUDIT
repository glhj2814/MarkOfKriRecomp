  134:         ModuleLoadResult hle = m_impl->moduleManager.loadHle(path);
  135:         if (hle.moduleId > 0)
  136:         {
  137:             m_impl->rebuildRoutes();
  138:             if (parsed.device != Ps2PathDevice::Rom0)
  139:                 m_impl->recordLoadOutcome(path, true);
  140:         }
