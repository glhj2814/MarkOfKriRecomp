   53:                     continue;
   54:                 for (const uint32_t sid : service->sids())
   55:                 {
   56:                     if (!routes.emplace(sid, service.get()).second)
   57:                     {
   58:                         std::ostringstream out;
   59:                         out << "duplicate IOP SID 0x" << std::hex << sid << " in core services";
