  637:     void sceSifSetDma(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
  638:     {
  639:         const uint32_t dmatAddr = getRegU32(ctx, 4);
  640:         const uint32_t count = getRegU32(ctx, 5);
  641: 
  642:         const uint32_t listAddr = getRegU32(ctx, 4);
  643:         PS2_IF_AGRESSIVE_LOGS({
  644:             std::cerr << "[sceSifSetDma:CALL] pc=0x" << std::hex << ctx->pc
  645:                       << " ra=0x" << getRegU32(ctx, 31)
  646:                       << " list=0x" << listAddr
  647:                       << " count=" << std::dec << count
  648:                       << std::endl;
  649: 
  650:             for (uint32_t i = 0; i < count; ++i)
  651:             {
  652:                 const uint32_t desc = listAddr + i * 16;
  653:                 const uint32_t src = READ32(desc + 0);
  654:                 const uint32_t dst = READ32(desc + 4);
  655:                 const uint32_t size = READ32(desc + 8);
  656:                 const uint32_t attr = READ32(desc + 12);
  657: 
  658:                 std::cerr << "[sceSifSetDma:DESC] i=" << i
  659:                           << " src=0x" << std::hex << src
  660:                           << " dst=0x" << dst
  661:                           << " size=0x" << size
  662:                           << " attr=0x" << attr
  663:                           << " pc=0x" << ctx->pc
  664:                           << " ra=0x" << getRegU32(ctx, 31)
  665:                           << std::dec << std::endl;
  666:             }
  667:         });
  668: 
  669:         if (!dmatAddr || count == 0u || count > 32u)
  670:         {
  671:             setReturnS32(ctx, 0);
  672:             return;
  673:         }
  674: 
  675:         std::array<Ps2SifDmaTransfer, 32u> pending{};
  676:         uint32_t pendingCount = 0u;
  677:         bool ok = true;
  678:         for (uint32_t i = 0; i < count; ++i)
  679:         {
  680:             const uint32_t entryAddr = dmatAddr + (i * static_cast<uint32_t>(sizeof(Ps2SifDmaTransfer)));
  681:             const uint8_t *entry = getConstMemPtr(rdram, entryAddr);
  682:             if (!entry)
  683:             {
  684:                 ok = false;
  685:                 break;
  686:             }
  687: 
  688:             Ps2SifDmaTransfer xfer{};
  689:             std::memcpy(&xfer, entry, sizeof(xfer));
  690:             if (xfer.size <= 0)
  691:             {
  692:                 continue;
  693:             }
  694: 
  695:             const uint32_t sizeBytes = static_cast<uint32_t>(xfer.size);
  696:             if (sizeBytes > PS2_RAM_SIZE)
  697:             {
  698:                 ok = false;
  699:                 break;
  700:             }
  701:             if (!runtime || !canAccessEeRange(rdram, xfer.src, sizeBytes) || !runtime->isIopMemoryRange(xfer.dest, sizeBytes))
  702:             {
  703:                 ok = false;
  704:                 break;
  705:             }
  706: 
  707:             pending[pendingCount++] = xfer;
  708:         }
  709: 
  710:         if (ok)
  711:         {
  712:             for (uint32_t i = 0; i < pendingCount; ++i)
  713:             {
  714:                 const Ps2SifDmaTransfer &xfer = pending[i];
  715:                 if (runtime)
  716:                 {
  717:                     PS2IopTransport::notifyTransfer(runtime, rdram, {
  718:                                                                         ps2x::iop::SifTransferKind::SetDma,
  719:                                                                         ps2x::iop::SifTransferPhase::BeforeCopy,
  720:                                                                         xfer.src,
  721:                                                                         xfer.dest,
  722:                                                                         static_cast<uint32_t>(xfer.size),
  723:                                                                     });
  724:                 }
  725:                 const uint32_t sizeBytes = static_cast<uint32_t>(xfer.size);
  726:                 std::vector<uint8_t> payload(sizeBytes);
  727:                 if (!readEeRange(rdram, xfer.src, payload.data(), sizeBytes) || !runtime->writeIopMemory(xfer.dest, payload.data(), payload.size()))
  728:                 {
  729:                     ok = false;
  730:                     break;
  731:                 }
  732:                 if (runtime)
  733:                 {
  734:                     PS2IopTransport::notifyTransfer(runtime, rdram, {
  735:                                                                         ps2x::iop::SifTransferKind::SetDma,
  736:                                                                         ps2x::iop::SifTransferPhase::AfterCopy,
  737:                                                                         xfer.src,
  738:                                                                         xfer.dest,
  739:                                                                         static_cast<uint32_t>(xfer.size),
  740:                                                                     });
  741:                 }
  742:             }
  743:         }
  744: 
  745:         if (!ok)
  746:         {
  747:             static uint32_t warnCount = 0;
  748:             if (warnCount < 32u)
  749:             {
  750:                 PS2_IF_AGRESSIVE_LOGS({
  751:                     std::cerr << "sceSifSetDma failed dmat=0x" << std::hex << dmatAddr
  752:                               << " count=0x" << count
  753:                               << std::dec << std::endl;
  754:                 });
  755:                 ++warnCount;
  756:             }
  757:             setReturnS32(ctx, 0);
  758:             return;
  759:         }
  760: 
  761:         ps2_syscalls::dispatchDmacHandlersForCause(rdram, runtime, 5u);
  762: 
  763:         setReturnS32(ctx, static_cast<int32_t>(allocateSifDmaTransferId()));
  764:     }
