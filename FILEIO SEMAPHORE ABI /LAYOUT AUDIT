   839:     void scePad2CreateSocket(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
   840:     {
   841:         (void)runtime;
   842:         // scePad2SocketParam: { int option; int port; int slot; int number; }
   843:         const uint32_t paramAddr = getRegU32(ctx, 4);
   844:         const uint8_t *param = getConstMemPtr(rdram, paramAddr);
   845:         if (!param)
   846:         {
   847:             setReturnS32(ctx, -1);
   848:             return;
   849:         }
   850: 
   851:         int32_t port = 0;
   852:         int32_t slot = 0;
   853:         std::memcpy(&port, param + 4, sizeof(port));
   854:         std::memcpy(&slot, param + 8, sizeof(slot));
   855: 
   856:         std::lock_guard<std::mutex> lock(g_padStateMutex);
   857:         PadPortState *portState = lookupPadPortStateLocked(port, slot);
   858:         if (!portState)
   859:         {
   860:             setReturnS32(ctx, -1);
   861:             return;
   862:         }
   863: 
   864:         for (size_t i = 0; i < kPad2SocketCount; ++i)
   865:         {
   866:             Pad2Socket &socket = g_pad2Sockets[i];
   867:             if (socket.open)
   868:             {
   869:                 continue;
   870:             }
   871:             socket = Pad2Socket{true, port, slot};
   872:             initializePadPortLocked(*portState, getRegU32(ctx, 5));
   873:             // dbcman drives the DualShock 2 in analog mode with pressure reporting from the start.
   874:             portState->analogMode = true;
   875:             portState->pressureEnabled = true;
   876:             setReturnS32(ctx, static_cast<int32_t>(i));
   877:             return;
   878:         }
   879:         setReturnS32(ctx, -1);
   880:     }
