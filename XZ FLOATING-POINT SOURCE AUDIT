  143: // PS2 float semantics (EE FPU and VU0 macro mode). The PS2 format has no Inf, NaN or denormals:
  144: //   - exponent 255 is an ordinary exponent, so 0x7F800000 is 2^128 and the largest value is 0x7FFFFFFF;
  145: //   - exponent 0 is zero whatever the mantissa holds;
  146: //   - a result of 2^129 or more saturates to +-0x7FFFFFFF, one below 2^-126 becomes +-0;
  147: //   - x/0 gives +-0x7FFFFFFF.
  148: // A host float cannot hold the exponent-255 values, so anything that touches them is computed in double.
  149: // That path is rare and kept out of line; the inline part is the host operation and a range check.
  150: // One case is left to the host: ADD.S/SUB.S/MUL.S and the vector operations do not look for an operand with
  151: // exponent 0 and a non-zero mantissa, so it takes part with its tiny host value instead of as zero.
  152: // Checked against the hardware results in ps2autotests (tests/cpu/ee_fpu).
  153: #if defined(_MSC_VER)
  154: #define PS2_FLOAT_NOINLINE __declspec(noinline)
  155: #else
  156: #define PS2_FLOAT_NOINLINE __attribute__((noinline))
  157: #endif
  158: 
  159: constexpr uint32_t PS2_FLOAT_MAX_BITS = 0x7FFFFFFFu;
  160: constexpr uint32_t PS2_FLOAT_EXP_MASK = 0x7F800000u;
  161: constexpr uint32_t PS2_FLOAT_SIGN_MASK = 0x80000000u;
  162: 
  163: // True when a host float operation cannot be trusted with x: exponent 255, or exponent 0 with a mantissa.
  164: inline bool ps2_fspecial(float x)
  165: {
  166:     const uint32_t t = std::bit_cast<uint32_t>(x) & 0x7FFFFFFFu;
  167:     return t != 0u && (t - 0x00800000u) >= 0x7F000000u;
  168: }
  169: 
  170: inline double ps2_to_double(float x)
  171: {
  172:     uint32_t b = std::bit_cast<uint32_t>(x);
  173:     const uint32_t exponent = b & PS2_FLOAT_EXP_MASK;
  174:     if (exponent == 0u)
  175:         return static_cast<double>(std::bit_cast<float>(b & PS2_FLOAT_SIGN_MASK));
  176:     if (exponent == PS2_FLOAT_EXP_MASK)
  177:         return static_cast<double>(std::bit_cast<float>(b - 0x00800000u)) * 2.0;
  178:     return static_cast<double>(x);
  179: }
