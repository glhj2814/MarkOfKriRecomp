  847: template <typename Ctx>
  848: inline __m128i ps2_pmfhl(const Ctx *ctx, int mode)
  849: {
  850:     const uint64_t lanes[4] = {ctx->lo, ctx->hi, ctx->lo1, ctx->hi1};
  851:     switch (mode)
  852:     {
  853:     case 0: // LW
  854:         return _mm_set_epi32(static_cast<int>(static_cast<uint32_t>(lanes[3])), static_cast<int>(static_cast<uint32_t>(lanes[2])),
  855:                              static_cast<int>(static_cast<uint32_t>(lanes[1])), static_cast<int>(static_cast<uint32_t>(lanes[0])));
  856:     case 1: // UW
  857:         return _mm_set_epi32(static_cast<int>(lanes[3] >> 32), static_cast<int>(lanes[2] >> 32),
  858:                              static_cast<int>(lanes[1] >> 32), static_cast<int>(lanes[0] >> 32));
  859:     case 2: // SLW
  860:         return _mm_set_epi64x(ps2_pmfhl_slw_lane(ctx->hi1, ctx->lo1), ps2_pmfhl_slw_lane(ctx->hi, ctx->lo));
  861:     case 3: // LH: halfwords 0 and 2 of LO, HI, LO1, HI1
  862:     {
  863:         uint16_t h[8];
  864:         for (int i = 0; i < 4; ++i)
  865:         {
  866:             h[i * 2] = static_cast<uint16_t>(lanes[i]);
  867:             h[i * 2 + 1] = static_cast<uint16_t>(lanes[i] >> 32);
  868:         }
  869:         return _mm_set_epi16(static_cast<short>(h[7]), static_cast<short>(h[6]), static_cast<short>(h[5]), static_cast<short>(h[4]),
  870:                              static_cast<short>(h[3]), static_cast<short>(h[2]), static_cast<short>(h[1]), static_cast<short>(h[0]));
  871:     }
  872:     default: // SH: every 32-bit word of LO, HI, LO1, HI1 saturated to 16 bits
  873:     {
  874:         int16_t h[8];
  875:         for (int i = 0; i < 4; ++i)
  876:         {
  877:             h[i * 2] = ps2_saturate_s16(static_cast<uint32_t>(lanes[i]));
  878:             h[i * 2 + 1] = ps2_saturate_s16(static_cast<uint32_t>(lanes[i] >> 32));
  879:         }
  880:         return _mm_set_epi16(h[7], h[6], h[5], h[4], h[3], h[2], h[1], h[0]);
  881:     }
  882:     }
  883: }
