  321: // Lane by lane through the scalar helpers; only reached when a result lane has exponent 255.
  322: PS2_FLOAT_NOINLINE inline __m128 ps2_vslow(__m128 a, __m128 b, Ps2VecOp op)
  323: {
  324:     alignas(16) float la[4], lb[4], lr[4];
  325:     _mm_store_ps(la, a);
  326:     _mm_store_ps(lb, b);
  327:     for (int i = 0; i < 4; ++i)
  328:     {
  329:         switch (op)
  330:         {
  331:         case Ps2VecOp::Add:
  332:             lr[i] = ps2_fadd_slow(la[i], lb[i]);
  333:             break;
  334:         case Ps2VecOp::Sub:
  335:             lr[i] = ps2_fsub_slow(la[i], lb[i]);
  336:             break;
  337:         default:
  338:             lr[i] = ps2_fmul_slow(la[i], lb[i]);
  339:             break;
  340:         }
  341:     }
  342:     return _mm_load_ps(lr);
  343: }
  344: 
  345: // r is the host result of a op b. As in ps2_fnormal, testing r alone finds every lane that needs the double
  346: // path. Results with exponent 0 are flushed to +-0.
  347: inline __m128 ps2_vfinish(__m128 a, __m128 b, __m128 r, Ps2VecOp op)
  348: {
  349:     const __m128i expMask = _mm_set1_epi32(0x7F800000);
  350:     const __m128i rexp = _mm_and_si128(_mm_castps_si128(r), expMask);
  351:     if (_mm_movemask_epi8(_mm_cmpeq_epi32(rexp, expMask)) != 0)
  352:         return ps2_vslow(a, b, op);
  353:     const __m128i flush = _mm_and_si128(_mm_cmpeq_epi32(rexp, _mm_setzero_si128()), _mm_set1_epi32(0x7FFFFFFF));
  354:     return _mm_castsi128_ps(_mm_andnot_si128(flush, _mm_castps_si128(r)));
  355: }
  356: 
  357: inline __m128 ps2_vadd(__m128 a, __m128 b)
  358: {
  359:     return ps2_vfinish(a, b, _mm_add_ps(a, b), Ps2VecOp::Add);
  360: }
  361: 
  362: inline __m128 ps2_vsub(__m128 a, __m128 b)
  363: {
  364:     return ps2_vfinish(a, b, _mm_sub_ps(a, b), Ps2VecOp::Sub);
  365: }
  366: 
  367: inline __m128 ps2_vmul(__m128 a, __m128 b)
  368: {
  369:     return ps2_vfinish(a, b, _mm_mul_ps(a, b), Ps2VecOp::Mul);
  370: }
