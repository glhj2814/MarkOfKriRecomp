  943: // QFSRV: Quadword Funnel Shift Right Variable
  944: // Concatenates rs || rt (256 bits) and right-shifts by SA bits, taking lower 128 bits.
  945: inline __m128i ps2_qfsrv(__m128i rs, __m128i rt, uint32_t sa)
  946: {
  947:     if (sa == 0)
  948:         return rt;
  949:     if (sa >= 128)
  950:     {
  951:         if (sa >= 256)
  952:             return _mm_setzero_si128();
  953:         uint32_t shift = sa - 128;
  954:         if (shift == 0)
  955:             return rs;
  956:         // Shift rs right by (sa-128) bits
  957:         uint32_t byteShift = shift / 8;
  958:         uint32_t bitShift = shift % 8;
  959:         // Byte shift rs right
  960:         alignas(16) uint8_t buf[16] = {};
  961:         alignas(16) uint8_t src[16];
  962:         _mm_store_si128((__m128i *)src, rs);
  963:         for (uint32_t i = 0; i + byteShift < 16; i++)
  964:             buf[i] = src[i + byteShift];
  965:         __m128i result = _mm_load_si128((__m128i *)buf);
  966:         if (bitShift > 0)
  967:             result = _mm_or_si128(_mm_srli_epi64(result, bitShift),
  968:                                   _mm_slli_epi64(_mm_bsrli_si128(result, 8), 64 - bitShift));
  969:         return result;
  970:     }
  971:     // sa is 1..127: result = (rs || rt) >> sa, lower 128 bits
  972:     uint32_t byteShift = sa / 8;
  973:     uint32_t bitShift = sa % 8;
  974:     alignas(16) uint8_t combined[32];
  975:     _mm_store_si128((__m128i *)(combined), rt);      // low 128 bits
  976:     _mm_store_si128((__m128i *)(combined + 16), rs); // high 128 bits
  977:     // Shift right by byteShift bytes
  978:     alignas(16) uint8_t shifted[16];
  979:     for (uint32_t i = 0; i < 16; i++)
  980:         shifted[i] = (i + byteShift < 32) ? combined[i + byteShift] : 0;
  981:     __m128i result = _mm_load_si128((__m128i *)shifted);
  982:     if (bitShift > 0)
  983:     {
  984:         uint8_t extra = (byteShift + 16 < 32) ? combined[byteShift + 16] : 0;
  985:         __m128i hi_byte = _mm_insert_epi8(_mm_setzero_si128(), extra, 15);
  986:         alignas(16) uint8_t src32[32];
  987:         for (uint32_t i = 0; i < 32; i++)
  988:             src32[i] = combined[i];
  989:         uint64_t lo0, lo1, hi0, hi1;
  990:         std::memcpy(&lo0, src32, 8);
  991:         std::memcpy(&lo1, src32 + 8, 8);
  992:         std::memcpy(&hi0, src32 + 16, 8);
  993:         std::memcpy(&hi1, src32 + 24, 8);
  994:         // 256-bit right shift by sa bits
  995:         uint64_t r0, r1;
  996:         if (sa < 64)
  997:         {
  998:             r0 = (lo0 >> sa) | (lo1 << (64 - sa));
  999:             r1 = (lo1 >> sa) | (hi0 << (64 - sa));
 1000:         }
 1001:         else if (sa < 128)
 1002:         {
 1003:             uint32_t s = sa - 64;
 1004:             if (s == 0)
 1005:             {
 1006:                 r0 = lo1;
 1007:                 r1 = hi0;
 1008:             }
 1009:             else
 1010:             {
 1011:                 r0 = (lo1 >> s) | (hi0 << (64 - s));
 1012:                 r1 = (hi0 >> s) | (hi1 << (64 - s));
 1013:             }
 1014:         }
 1015:         else
 1016:         {
 1017:             r0 = 0;
 1018:             r1 = 0; // handled above
 1019:         }
 1020:         result = _mm_set_epi64x((long long)r1, (long long)r0);
 1021:     }
 1022:     return result;
 1023: }
