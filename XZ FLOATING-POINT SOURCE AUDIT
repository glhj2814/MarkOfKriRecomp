  685: // Packed Subtract with Signed Saturation Word (PSUBSW)
  686: inline __m128i ps2_psubsw(__m128i a, __m128i b)
  687: {
  688:     __m128i diff = _mm_sub_epi32(a, b);
  689:     // Check for over/underflow. Clamp to either INT32_MIN/INT32_MAX.
  690:     __m128i overflow = _mm_and_si128(_mm_xor_si128(a, b),
  691:                                      _mm_xor_si128(a, diff));
  692:     // Extract input sign.
  693:     overflow = _mm_srai_epi32(overflow, 31);
