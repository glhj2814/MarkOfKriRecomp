  228: // A zero divisor gives +-max with the sign of fs xor ft.
  229: PS2_FLOAT_NOINLINE inline float ps2_fdiv_slow(float a, float b)
  230: {
  231:     const uint32_t ua = std::bit_cast<uint32_t>(a);
  232:     const uint32_t ub = std::bit_cast<uint32_t>(b);
  233:     if ((ub & PS2_FLOAT_EXP_MASK) == 0u)
  234:         return std::bit_cast<float>(((ua ^ ub) & PS2_FLOAT_SIGN_MASK) | PS2_FLOAT_MAX_BITS);
  235:     const float r = a / b;
  236:     if (!(ps2_fspecial(a) | ps2_fspecial(b) | ps2_fspecial(r)))
  237:         return r;
  238:     return ps2_from_double(ps2_to_double(a) / ps2_to_double(b));
  239: }
  240: 
  241: // sqrt(|ft|); the result is never negative, sqrt(-0) is +0.
  242: PS2_FLOAT_NOINLINE inline float ps2_fsqrt_slow(float a)
  243: {
  244:     if ((std::bit_cast<uint32_t>(a) & PS2_FLOAT_EXP_MASK) == 0u)
  245:         return 0.0f;
  246:     return ps2_from_double(std::sqrt(std::fabs(ps2_to_double(a))));
  247: }
  248: 
  249: // fs / sqrt(|ft|). The sign of ft is ignored everywhere, so a zero ft gives +-max with the sign of fs alone.
  250: PS2_FLOAT_NOINLINE inline float ps2_frsqrt_slow(float a, float b)
  251: {
  252:     if ((std::bit_cast<uint32_t>(b) & PS2_FLOAT_EXP_MASK) == 0u)
  253:         return std::bit_cast<float>((std::bit_cast<uint32_t>(a) & PS2_FLOAT_SIGN_MASK) | PS2_FLOAT_MAX_BITS);
  254:     // The root is rounded to a float before the division, as on the hardware.
  255:     const float root = ps2_from_double(std::sqrt(std::fabs(ps2_to_double(b))));
  256:     return ps2_from_double(ps2_to_double(a) / static_cast<double>(root));
  257: }
  258: 
  259: // True when a, b and the host result r are all normal numbers, so r is also the PS2 result.
  260: inline bool ps2_fall_normal(float a, float b, float r)
  261: {
  262:     // Doubling drops the sign; adding one exponent step wraps exponent 255 round to 0 next to exponent 0.
  263:     const uint32_t sa = std::bit_cast<uint32_t>(a) * 2u + 0x01000000u;
  264:     const uint32_t sb = std::bit_cast<uint32_t>(b) * 2u + 0x01000000u;
  265:     const uint32_t sr = std::bit_cast<uint32_t>(r) * 2u + 0x01000000u;
  266:     uint32_t lowest = sa < sb ? sa : sb;
  267:     lowest = lowest < sr ? lowest : sr;
  268:     return lowest >= 0x02000000u;
  269: }
  270: 
  271: // The same test on the result alone. An exponent-255 operand always leaves exponent 255 in the host result
  272: // of an addition, subtraction or multiplication (Inf or NaN), so this finds those operands as well.
  273: inline bool ps2_fnormal(float r)
  274: {
  275:     return (std::bit_cast<uint32_t>(r) * 2u + 0x01000000u) >= 0x02000000u;
  276: }
  277: 
  278: inline float ps2_fadd(float a, float b)
  279: {
  280:     const float r = a + b;
  281:     return ps2_fnormal(r) ? r : ps2_fadd_slow(a, b);
  282: }
  283: 
  284: inline float ps2_fsub(float a, float b)
  285: {
  286:     const float r = a - b;
  287:     return ps2_fnormal(r) ? r : ps2_fsub_slow(a, b);
  288: }
  289: 
  290: inline float ps2_fmul(float a, float b)
  291: {
  292:     const float r = a * b;
  293:     return ps2_fnormal(r) ? r : ps2_fmul_slow(a, b);
  294: }
  295: 
  296: inline float ps2_fdiv(float a, float b)
  297: {
  298:     const float r = a / b;
  299:     return ps2_fall_normal(a, b, r) ? r : ps2_fdiv_slow(a, b);
  300: }
  301: 
  302: inline float ps2_fsqrt(float a)
  303: {
  304:     const float r = std::sqrt(a);
  305:     return ps2_fall_normal(a, a, r) ? r : ps2_fsqrt_slow(a);
  306: }
  307: 
  308: inline float ps2_frsqrt(float a, float b)
  309: {
  310:     const float r = a / std::sqrt(b);
  311:     return ps2_fall_normal(a, b, r) ? r : ps2_frsqrt_slow(a, b);
  312: }
