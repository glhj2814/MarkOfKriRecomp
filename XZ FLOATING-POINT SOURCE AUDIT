  780: inline __m128i _mm_custom_sllv_epi32(__m128i a, __m128i count)
  781: {
  782:     alignas(16) int32_t a_arr[4];
  783:     alignas(16) int32_t count_arr[4];
  784:     alignas(16) int32_t result[4];
  785: 
  786:     std::memcpy(a_arr, &a, sizeof(a));
  787:     std::memcpy(count_arr, &count, sizeof(count));
  788: 
  789:     for (int i = 0; i < 4; i++)
  790:     {
  791:         result[i] = a_arr[i] << (count_arr[i] & 0x1F);
  792:     }
  793: 
  794:     __m128i out;
  795:     std::memcpy(&out, result, sizeof(out));
  796:     return out;
  797: }
