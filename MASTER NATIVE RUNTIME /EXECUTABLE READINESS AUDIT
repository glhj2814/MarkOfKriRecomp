   91: {
   92:     if (addr >= PS2_SCRATCHPAD_BASE && addr < (PS2_SCRATCHPAD_BASE + PS2_SCRATCHPAD_SIZE))
   93:     {
   94:         return true;
   95:     }
   96: 
   97:     if ((addr & 0x80000000u) != 0u)
