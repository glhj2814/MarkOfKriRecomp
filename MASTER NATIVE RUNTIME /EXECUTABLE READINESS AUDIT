  128: inline bool ps2ResolveGuestPointer(uint32_t addr, uint32_t &offset, bool &scratch)
  129: {
  130:     if (ps2IsScratchpadAddress(addr))
  131:     {
  132:         scratch = true;
  133:         offset = ps2ScratchpadOffset(addr);
  134:         return true;
  135:     }
  136: 
  137:     uint32_t phys = 0;
  138:     if (addr < 0x20000000u)
  139:     {
  140:         phys = addr;
  141:     }
  142:     else if ((addr >= 0x20000000u && addr < 0x40000000u) ||
  143:              (addr >= 0x80000000u && addr < 0xC0000000u))
  144:     {
  145:         phys = addr & 0x1FFFFFFFu;
  146:     }
  147: 
  148:     if (phys >= PS2_RAM_SIZE)
  149:     {
  150:         phys &= PS2_RAM_MASK;
  151:     }
  152: 
  153:     scratch = false;
  154:     offset = phys;
  155:     return true;
  156: }
