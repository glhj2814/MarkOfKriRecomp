  118: {
  119:     if (addr >= PS2_SCRATCHPAD_BASE && addr < (PS2_SCRATCHPAD_BASE + PS2_SCRATCHPAD_SIZE))
  120:     {
  121:         return addr - PS2_SCRATCHPAD_BASE;
  122:     }
  123: 
  124:     const uint32_t lower = addr & 0x7FFFFFFFu;
  125:     return lower - PS2_SCRATCHPAD_BASE;
  126: }
